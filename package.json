{
  "name": "meticulous-ui",
  "version": "2.5.4",
  "license": "MIT",
  "description": "A comprehensive React UI component library with a wide range of customizable components, icons, colors, and utilities for building modern web applications.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/xe3110/meticulous-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "colors",
    "components",
    "utils",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "peerDependencies": {
    "lodash-es": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "icons",
    "components",
    "pagination",
    "toasts",
    "button",
    "input",
    "textarea",
    "checkbox",
    "radio",
    "file-uploader",
    "notification",
    "dropdown",
    "select-box",
    "spinner",
    "otp",
    "colors",
    "shades",
    "utils",
    "meticulous-ui"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "npx prettier --write .",
    "publish:latest": "npm run build && npm publish --access public",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "gh-pages -d storybook-static",
    "generate-icons": "rm -rf src/components/Icons/* && node src/scripts/generateIcons.js && npx prettier --write .",
    "prepublish": "npm run build && node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));p.main='./index.js';p.module='./index.js';delete p.scripts;delete p.devDependencies;fs.writeFileSync('dist/package.json',JSON.stringify(p,null,2))\" && cp README.md dist/",
    "publish:dist": "npm publish dist/"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/mdx2-csf": "^1.1.0",
    "@storybook/react-vite": "^9.1.10",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint-plugin-storybook": "^9.1.10",
    "gh-pages": "^6.3.0",
    "prop-types": "^15.8.1",
    "storybook": "^9.1.10",
    "svgo": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "styled-components": "^6.0.0",
    "lodash-es": "^4.17.21"
  }
}
