{
  "name": "meticulous-ui",
  "version": "3.10.3",
  "license": "ISC",
  "description": "A comprehensive React UI component library with a wide range of customizable components, icons, colors, and utilities for building modern web applications.",
  "types": "./index.d.ts",
  "main": "./cjs/index.cjs",
  "module": "./index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/xe3110/meticulous-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./cjs/index.cjs",
      "default": "./index.js"
    },
    "./components/Icons/*": {
      "import": "./components/Icons/*.js",
      "require": "./cjs/components/Icons/*.cjs"
    },
    "./components/*": "./components/*/index.js",
    "./hooks": "./hooks/index.js",
    "./hooks/*": "./hooks/*.js",
    "./utils": "./utils/index.js",
    "./utils/*": "./utils/*.js",
    "./reactUtils": "./reactUtils/index.js",
    "./reactUtils/*": "./reactUtils/*.js",
    "./colors": "./colors/index.js",
    "./colors/*": "./colors/*.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cjs",
    "chunks",
    "assets",
    "components",
    "hooks",
    "utils",
    "reactUtils",
    "colors",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "prop-types": ">=15.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "prop-types": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "reactjs",
    "react-components",
    "ui-library",
    "component-library",
    "design-system",
    "react-ui",
    "typescript",
    "styled-components",
    "hooks",
    "custom-hooks",
    "utilities",
    "frontend-toolkit",
    "frontend-platform",
    "enterprise-ui",
    "tree-shaking",
    "side-effects-free",
    "zero-dependencies",
    "accessible",
    "accessibility",
    "aria",
    "storybook",
    "design-tokens",
    "icons",
    "react-hooks",
    "performance",
    "scalable-ui",
    "dashboard-ui",
    "frontend-architecture"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "npx prettier --write .",
    "generate-icons": "rm -rf src/components/Icons/* && node src/scripts/generateIcons.js && npx prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "gh-pages -d storybook-static",
    "prepublish": "npm run build && node -e \"const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.main='./cjs/index.cjs'; p.module='./index.js'; delete p.scripts; delete p.devDependencies; fs.writeFileSync('dist/package.json', JSON.stringify(p,null,2))\" && cp README.md dist/ && cp index.d.ts dist/",
    "publish:dist": "npm publish dist/"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/mdx2-csf": "^1.1.0",
    "@storybook/react-vite": "^9.1.10",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "eslint-plugin-storybook": "^9.1.10",
    "gh-pages": "^6.3.0",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "storybook": "^9.1.10",
    "styled-components": "^6.0.0",
    "svgo": "^4.0.0",
    "vite": "^6.0.0",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-svgr": "^4.5.0"
  }
}
